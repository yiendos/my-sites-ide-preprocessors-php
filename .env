# PHP settings for fpm and cli - read by conf/custom.ini. Override any of them in the IDE's root .env.
XDEBUG_CLIENT_HOST=host.docker.internal

PHP_UPLOAD=128M
PHP_DEFAULT_CHARSET=UTF-8
PHP_DISPLAY_ERRORS=On
PHP_DISPLAY_STARTUP_ERRORS=On
PHP_SHORT_OPEN_TAG=On
PHP_HTML_ERRORS=On
PHP_ERROR_REPORTING=On
PHP_MEMORY_LIMIT=512M
PHP_EXPOSE_PHP=Off
PHP_ALLOW_URL_OPEN=Off
PHP_LOG_ERRORS=On
PHP_ERROR_LOG=/dev/stderr
PHP_DATE_TIMEZONE=UTC
PHP_SESSION_STRICT=On
PHP_SESSION_COOKIE_HTTP=On
PHP_SESSION_COOKIE_SECURE=On
PHP_SESSION_COOKIE_SAMESITE=Strict
PHP_MAX_EXECUTION_TIME=45
PHP_MAX_INPUT_TIME=60
PHP_MAX_SIZE=20M

# fpm blocks these by default. To lift every restriction while developing, put
# PHP_DISABLE_FUNCTIONS= (with nothing after it) in the root .env
PHP_DISABLE_FUNCTIONS=phpinfo,exec,passthru,shell_exec,system,popen,pcntl_alarm,pcntl_fork,pcntl_waitpid,pcntl_wait,pcntl_wifexited,pcntl_wifstopped,pcntl_wifsignaled,pcntl_wexitstatus,pcntl_wtermsig,pcntl_wstopsig,pcntl_signal,pcntl_signal_dispatch,pcntl_get_last_error,pcntl_strerror,pcntl_sigprocmask,pcntl_sigwaitinfo,pcntl_sigtimedwait,pcntl_exec,pcntl_getpriority,pcntl_setpriority
# cli blocks nothing by default - queue workers need pcntl_*, and some jobs shell out
PHP_CLI_DISABLE_FUNCTIONS=
